# Owner/migration connection for schema changes and tests. Never use it in the API.
# Keep the real URL in .env, never in source control.
DATABASE_URL=postgresql://OWNER:OWNER_PASSWORD@HOST/DATABASE?sslmode=require

# API must use this limited role, not DATABASE_URL. Set ledger_app's password separately in Neon.
APP_DATABASE_URL=postgresql://ledger_app:APP_PASSWORD@HOST/DATABASE?sslmode=require

# Optional direct connections for reporting and admin tools. Set passwords separately in Neon.
REPORTING_DATABASE_URL=postgresql://ledger_reporting:REPORTING_PASSWORD@HOST/DATABASE?sslmode=require
ADMIN_DATABASE_URL=postgresql://ledger_admin:ADMIN_PASSWORD@HOST/DATABASE?sslmode=require
